# Everything here is optional: CloudAudit360 runs without a .env file.
# Copy to .env only to override a default.

# Database (default: cloudaudit360.db in the project folder)
# DATABASE_URL=sqlite:///./cloudaudit360.db

# Dashboard admin account. Default: admin / admin, and you must choose a new
# password at first sign-in. Locked out? Run: python -m app.cli reset-admin
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Session secret. Default: generated once and kept in .secret_key
# SECRET_KEY=

# AWS: use a read-only profile or role (SecurityAudit + ViewOnlyAccess)
AWS_PROFILE=
AWS_REGIONS=
